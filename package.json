{
  "name": "@silsilah/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "jest --runInBand",
    "test:db": "jest --config jest.db.config.cjs --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "data:import": "tsx scripts/import-family.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "test:integration": "tsx scripts/run-db-tests.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@prisma/client": "6.19.0",
    "@silsilah/family": "file:../../packages/family",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.12",
    "@nestjs/testing": "^11.1.9",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "embedded-postgres": "18.7.0-beta.19",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "5.8.3"
  }
