# Development only. Use strong unique passwords and HTTPS/private access in production.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATASET_ID=asrori
DATABASE_URL=postgresql://silsilah_reader:local-reader-only@localhost:5432/silsilah?schema=public&connection_limit=5
DIRECT_URL=postgresql://silsilah:local-development-only@localhost:5432/silsilah?schema=public&connection_limit=5
