# Development only. Use strong unique passwords and HTTPS/private access in production.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATASET_ID=asrori
DATABASE_URL=postgresql://silsilah_reader:local-reader-only@localhost:5432/silsilah?schema=public&connection_limit=5
DIRECT_URL=postgresql://silsilah:local-development-only@localhost:5432/silsilah?schema=public&connection_limit=5
# Optional locally; REQUIRED in production. Same value as mobile's apiReadToken.
# This shared key is a basic access gate, not per-user authentication.
API_READ_TOKEN=
# Leave empty for native-only use. Comma-separated origins if needed.
CORS_ORIGINS=
# Public SHA-256 fingerprints of Android distribution certificates, in colon-separated hex.
# Use commas between fingerprints if more than one distribution certificate is active.
ANDROID_APP_LINK_SHA256_FINGERPRINTS=

# Optional dashboard integration. Keep these server-side.
ADMIN_DATABASE_URL=
ADMIN_API_TOKEN=
